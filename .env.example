# GeneralAI environment template
#
# Copy to `.env` (project root) and customise. Every variable here is
# optional; the application runs out-of-the-box with its defaults in
# mock mode (no AI credentials required).
#
#   cp .env.example .env
#
# Settings are loaded with the following precedence (highest wins):
#   1. CLI arguments
#   2. Environment variables (GENERAL_AI_*)
#   3. .env file in the project root
#   4. Defaults in app/config/defaults.py
#
# NOTE: Server authentication/rate-limit/CORS are configured
# programmatically via `ServerSettings` (see app.server.config), NOT via
# environment variables — there is no GENERAL_AI_API_KEY variable.

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
# Runtime environment. One of: development, staging, production.
GENERAL_AI_ENVIRONMENT=development

# Logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
GENERAL_AI_LOG_LEVEL=INFO

# Enable debug mode (extra detail/logging). true or false.
GENERAL_AI_DEBUG=false

# Toggle console and file logging independently. true or false.
GENERAL_AI_LOG_TO_CONSOLE=true
GENERAL_AI_LOG_TO_FILE=true

# Override the default data/log/models directories.
GENERAL_AI_LOG_DIR=logs
GENERAL_AI_DATA_DIR=data
GENERAL_AI_MODELS_DIR=models

# ---------------------------------------------------------------------
# LLM provider mode
# ---------------------------------------------------------------------
# mock: deterministic offline responses, no credentials needed (default).
# real: registers providers whose configuration is present below.
GENERAL_AI_API_MODE=mock

# ---------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------
GENERAL_AI_OPENAI_API_KEY=
GENERAL_AI_OPENAI_MODEL=
GENERAL_AI_OPENAI_URL=

# ---------------------------------------------------------------------
# OpenRouter
# ---------------------------------------------------------------------
GENERAL_AI_OPENROUTER_API_KEY=
GENERAL_AI_OPENROUTER_MODEL=
GENERAL_AI_OPENROUTER_URL=

# ---------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------
GENERAL_AI_GEMINI_API_KEY=
GENERAL_AI_GEMINI_MODEL=

# ---------------------------------------------------------------------
# Ollama (local server — no API key required)
# ---------------------------------------------------------------------
GENERAL_AI_OLLAMA_URL=
GENERAL_AI_OLLAMA_MODEL=